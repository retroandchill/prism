<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>15</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''"
      >$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="LLVMSharp" />
    <PackageReference Include="MagicArchive"/>
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <PackageReference Include="Microsoft.VisualStudio.Setup.Configuration.Interop" />
    <PackageReference Include="Nerdbank.Streams" />
    <PackageReference Include="NetEscapades.EnumGenerators" />
    <PackageReference Include="Nito.Collections.Deque" />
    <PackageReference Include="Riok.Mapperly" />
    <PackageReference Include="Semver" />
    <PackageReference Include="Singulink.Numerics.BigDecimal" />
    <PackageReference Include="SoftUni.Wintellect.PowerCollections" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="System.Linq.AsyncEnumerable" />
    <PackageReference Include="ZLinq" />
    <PackageReference Include="ZString" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Prism.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prism.Constants\Prism.Constants.csproj" />
    <ProjectReference Include="..\Prism.Diagnostics\Prism.Diagnostics.csproj" />
    <ProjectReference Include="..\Prism.Metadata.Abstractions\Prism.Metadata.Abstractions.csproj" />
    <ProjectReference Include="..\Prism.Metadata\Prism.Metadata.csproj" />
    <ProjectReference Include="..\Prism.Syntax\Prism.Syntax.csproj" />
    <ProjectReference Include="..\Prism.Text\Prism.Text.csproj" />
    <ProjectReference Include="..\Prism.Utils\Prism.Utils.csproj" />
  </ItemGroup>
</Project>
