<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Humanizer" GeneratePathProperty="true"/>
      <PackageReference Include="Humanizer.Core" GeneratePathProperty="true" />
      <PackageReference Include="JetBrains.Annotations" />
      <PackageReference Include="Microsoft.Bcl.Memory" GeneratePathProperty="true" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
      <PackageReference Include="PolySharp">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Riok.Mapperly" />
      <PackageReference Include="SoftCircuits.OrderedDictionary" GeneratePathProperty="true" />
      <PackageReference Include="System.Text.Json" />
      <PackageReference Include="ZLinq" GeneratePathProperty="true" />
      <PackageReference Include="ZString" GeneratePathProperty="true" />
    </ItemGroup>

    <PropertyGroup>
        <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
    </PropertyGroup>
    <Target Name="GetDependencyTargetPaths">
        <ItemGroup>
            <TargetPathWithTargetPlatformMoniker
                    Include="$(PkgZString)\lib\netstandard2.0\ZString.dll"
                    IncludeRuntimeDependency="false"
            />
            <ReferenceCopyLocalPaths Include="$(PkgZString)\lib\netstandard2.0\ZString.dll" />
        </ItemGroup>
        <ItemGroup>
            <TargetPathWithTargetPlatformMoniker
                    Include="$(PkgZLinq)\lib\netstandard2.0\ZLinq.dll"
                    IncludeRuntimeDependency="false"
            />
            <ReferenceCopyLocalPaths Include="$(PkgZLinq)\lib\netstandard2.0\ZLinq.dll" />
        </ItemGroup>
        <ItemGroup>
            <TargetPathWithTargetPlatformMoniker
                    Include="$(PkgHumanizer_Core)\lib\netstandard2.0\Humanizer.dll"
                    IncludeRuntimeDependency="false"
            />
            <ReferenceCopyLocalPaths Include="$(PkgHumanizer_Core)\lib\netstandard2.0\Humanizer.dll" />
        </ItemGroup>
        <ItemGroup>
            <TargetPathWithTargetPlatformMoniker
                    Include="$(PkgSoftCircuits_OrderedDictionary)\lib\netstandard2.0\SoftCircuits.OrderedDictionary.dll"
                    IncludeRuntimeDependency="false"
            />
            <ReferenceCopyLocalPaths Include="$(PkgSoftCircuits_OrderedDictionary)\lib\netstandard2.0\SoftCircuits.OrderedDictionary.dll" />
        </ItemGroup>
        <ItemGroup>
            <TargetPathWithTargetPlatformMoniker
                    Include="$(PkgMicrosoft_Bcl_Memory)\lib\netstandard2.0\Microsoft.Bcl.Memory.dll"
                    IncludeRuntimeDependency="false"
            />
            <ReferenceCopyLocalPaths Include="$(PkgMicrosoft_Bcl_Memory)\lib\netstandard2.0\Microsoft.Bcl.Memory.dll" />
        </ItemGroup>
    </Target>
    <ItemGroup>
        <None
                Include="$(PkgZString)\lib\netstandard2.0\ZString.dll"
                Pack="true"
                PackagePath="analyzers/roslyn$(ROSLYN_VERSION)/dotnet/cs"
                Visible="false"
        />
        <None
                Include="$(PkgZLinq)\lib\netstandard2.0\ZLinq.dll"
                Pack="true"
                PackagePath="analyzers/roslyn$(ROSLYN_VERSION)/dotnet/cs"
                Visible="false"
        />
        <None
                Include="$(PkgHumanizer_Core)\lib\netstandard2.0\Humanizer.dll"
                Pack="true"
                PackagePath="analyzers/roslyn$(ROSLYN_VERSION)/dotnet/cs"
                Visible="false"
        />
        <None
                Include="$(PkgSoftCircuits_OrderedDictionary)\lib\netstandard2.0\SoftCircuits.OrderedDictionary.dll"
                Pack="true"
                PackagePath="analyzers/roslyn$(ROSLYN_VERSION)/dotnet/cs"
                Visible="false"
        />
        <None
                Include="$(PkgMicrosoft_Bcl_Memory)\lib\netstandard2.0\Microsoft.Bcl.Memory.dll"
                Pack="true"
                PackagePath="analyzers/roslyn$(ROSLYN_VERSION)/dotnet/cs"
                Visible="false"
        />
    </ItemGroup>

</Project>
