<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Prism.Metadata.Abstractions\Prism.Metadata.Abstractions.csproj" />
      <ProjectReference Include="..\Prism.Text\Prism.Text.csproj" />
        <ProjectReference
                Include="..\Prism.SourceGenerator\Prism.SourceGenerator.csproj"
                OutputItemType="Analyzer"
                ReferenceOutputAssembly="false"
        />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Prism.Syntax" />
        <InternalsVisibleTo Include="Prism.Compiler" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="diagnostics.json" />
    </ItemGroup>

</Project>
