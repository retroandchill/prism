{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Prism",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#characters"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [{
				"name": "keyword.control.prism",
				"match": "\\b(if|while|loop|for|return|break|continue)\\b"
			},
			{
				"name": "keyword.declaration.prism",
				"match": "\\b(var|func|namespace)\\b"
			},
			{
				"name": "keyword.type.prism",
				"match": "\\b(void|bool|[iu](8|16|32|64|128|size)|f(32|64)|char|char16|rune|str)\\b"
			},
			{
				"name": "keyword.modifier.prism",
				"match": "\\b(extern|mutable|public|internal)\\b"
			},
			{
				"name": "keyword.boolean.prism",
				"match": "\\b(true|false)\\b"
			}]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.float",
					"match": "(?<![\\w.])[0-9]*\\.[0-9]+(f(32|64))?(?!\\w)"
				},
				{
					"name": "constant.numeric.integer",
					"match": "(?<![\\w.])[0-9]+([iu](8|16|32|64|128|z)|f(32|64))?(?!\\w)"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.prism",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.prism",
					"match": "\\\\."
				}
			]
		},
		"characters": {
			"name": "string.quoted.single.prism",
			"begin": "(\\b(u|U))?(')",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.prism",
					"match": "\\\\."
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.prism",
					"match": "//.*$"
				},
				{
					"name": "comment.block.prism",
					"match": "/\\*.*\\*/"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.comparison.prism",
					"match": "<=|=>|<|>|<=>"
				},
				{
					"name": "keyword.operator.assignment.prism",
					"match": "="
				},
				{
					"name": "keyword.operator.equality.prism",
					"match": "==|!="
				},
				{
					"name": "keyword.operator.arithmetic.prism",
					"match": "\\+|-|\\*|/|%"
				},
				{
					"name": "keyword.operator.unary.prism",
					"match": "\\+\\+|--"
				},
				{
					"name": "keyword.operator.logical.prism",
					"match": "&&|\\|\\||!"
				},
				{
					"name": "keyword.operator.bitwise.prism",
					"match": "&|\\||\\^|~|<<|>>|>>="
				},
				{
					"name": "keyword.operator.assignment.compound.prism",
					"match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|&&=|\\|\\|=|\\^=|<<=|>>=|>>>="
				},
				{
					"name": "keyword.operator.scope.compound.prism",
					"match": "::"
				}
			]
		}
	},
	"scopeName": "source.prism"
}
