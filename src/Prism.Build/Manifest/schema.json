{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": [
    "object"
  ],
  "properties": {
    "package": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "default": "0.0.0"
        }
      },
      "required": [
        "name"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["executable", "static-library", "shared-library"]
        }
      },
      "required": [
        "kind"
      ]
    }
  },
  "required": [
    "package",
    "output"
  ]
}
